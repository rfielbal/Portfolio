Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep stale work artifacts private even if an older manual upload left
    # them on the hosting account. The deployment manifest never sends them.
    RewriteRule ^(?:output|tmp|deploy|scripts)(?:/|$) - [R=404,L,NC]
    RewriteRule ^images/(?:profile|projects/[^/]+)/source(?:/|$) - [R=404,L,NC]
    RewriteRule ^documents/(?!cv-raphael-coursier\.pdf$|bulletins-public/bts-sio-semestre-[12]\.pdf$) - [R=404,L,NC]
    RewriteRule ^demos/escape-game/assets/artworks/(?:basquiat-skull|kandinsky-comp8)\.jpg$ - [R=404,L,NC]

    # Mark direct or proxy-terminated HTTPS requests for the conditional HSTS header.
    RewriteCond %{HTTPS} =on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} ^https(?:,|$) [NC]
    RewriteRule ^ - [E=RFIELBAL_HTTPS:1]

    # Collapse /index.html directly onto the canonical origin.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ https://rfielbal.fr/ [R=301,L]

    # Enforce the canonical host independently from the protocol check.
    RewriteCond %{HTTP_HOST} !^rfielbal\.fr$ [NC]
    RewriteRule ^ https://rfielbal.fr%{REQUEST_URI} [R=301,L]

    # Honour OVH/proxy HTTPS termination to avoid a redirect loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https(?:,|$) [NC]
    RewriteRule ^ https://rfielbal.fr%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:html?|txt|xml)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:css|js|avif|jpe?g|png|svg|webp|mp4|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^bts-sio-semestre-[0-9]+\.pdf$">
        Header set X-Robots-Tag "noindex, noarchive, nosnippet"
    </FilesMatch>
    Header always set Strict-Transport-Security "max-age=31536000" env=RFIELBAL_HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-mGiDN7pA4xv8fiWg3xIPxYSGztZFZ7hUeuAopf2GxO0=' 'sha256-VyEWDpLXUDcM7laI9n4blBM85jm1RtA4off3MK1bnkA=' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://storage.googleapis.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>
